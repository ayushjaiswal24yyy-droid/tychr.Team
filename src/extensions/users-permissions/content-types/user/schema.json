{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "fullName": {
      "type": "string"
    },
    "uuid": {
      "type": "string",
      "unique": true
    },
    "otp": {
      "type": "biginteger"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "phoneNumber": {
      "type": "string",
      "unique": true
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "mappedBy": "tutor"
    },
    "live_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::live-lecture.live-lecture",
      "mappedBy": "tutor"
    },
    "fav_topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "mappedBy": "fav_users"
    },
    "onBoarded": {
      "type": "boolean",
      "default": false
    },
    "grade": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::class.class",
      "inversedBy": "user"
    },
    "teaching": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "tutors"
    },
    "studying": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "students"
    },
    "title": {
      "type": "enumeration",
      "enum": [
        "IB Facilitator",
        "IB Examiner"
      ]
    }
  }
}
