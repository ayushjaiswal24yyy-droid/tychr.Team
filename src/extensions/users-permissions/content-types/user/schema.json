{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "fullName": {
      "type": "string",
      "unique": true
    },
    "uuid": {
      "type": "string",
      "unique": true
    },
    "otp": {
      "type": "biginteger"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "phoneNumber": {
      "type": "string",
      "unique": true
    },
    "fav_topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "mappedBy": "fav_users"
    },
    "onBoarded": {
      "type": "boolean",
      "default": false
    },
    "grade": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::class.class",
      "inversedBy": "user"
    },
    "teaching": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "tutors"
    },
    "studying": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "students"
    },
    "title": {
      "type": "enumeration",
      "enum": [
        "IB Facilitator",
        "IB Examiner"
      ]
    },
    "ib_program": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::ib-program.ib-program",
      "inversedBy": "user"
    },
    "grade_score": {
      "type": "integer"
    },
    "dream_profession": {
      "type": "string"
    },
    "dream_profession_secondary": {
      "type": "string"
    },
    "dream_university": {
      "type": "string"
    },
    "fav_subject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subject.subject",
      "inversedBy": "users_fav_subject"
    },
    "college_name": {
      "type": "string"
    },
    "tutor_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tutor-plan.tutor-plan",
      "inversedBy": "users"
    },
    "nationality": {
      "type": "string"
    },
    "lastUploaded": {
      "type": "date"
    },
    "experience": {
      "type": "integer"
    },
    "cv": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "audios",
        "files"
      ]
    },
    "biography": {
      "type": "text"
    },
    "student_plan": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-plan.course-plan"
    },
    "tutor_video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "classroom_limit": {
      "type": "integer",
      "default": 5
    },
    "communities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::community.community",
      "mappedBy": "members"
    },
    "subject_guidances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subject.subject",
      "mappedBy": "user"
    },
    "highest_educational_qualification": {
      "type": "string"
    },
    "teaching_certifications": {
      "type": "string"
    },
    "graduated_from": {
      "type": "string"
    },
    "field_of_study": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subject.subject"
    },
    "linkedIn_url": {
      "type": "string"
    },
    "subject_of_expertise": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subject.subject"
    },
    "confirmTutor": {
      "type": "boolean",
      "default": false
    },
    "tutor_o2o_cost_inr": {
      "type": "decimal"
    },
    "tutor_o2o_cost_usd": {
      "type": "decimal"
    },
    "tutor_group_cost_inr": {
      "type": "decimal"
    },
    "tutor_group_cost_usd": {
      "type": "decimal"
    },
    "messages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::message.message",
      "mappedBy": "receiver"
    },
    "tutor_status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Rejected",
        "Approved"
      ]
    },
    "tutor_type": {
      "type": "enumeration",
      "enum": [
        "Counsellors",
        "Faculty",
        "Trainer"
      ]
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "user"
    },
    "tutor_grade_subject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::grade-subject.grade-subject"
    },
    "answers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer.answer",
      "mappedBy": "student"
    },
    "classroom": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::enrollment.enrollment",
      "mappedBy": "assistant"
    }
  }
}
