{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "fullName": {
      "type": "string"
    },
    "uuid": {
      "type": "string",
      "unique": true
    },
    "otp": {
      "type": "biginteger"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "phoneNumber": {
      "type": "string",
      "unique": true
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "mappedBy": "tutor"
    },
    "live_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::live-lecture.live-lecture",
      "mappedBy": "tutor"
    },
    "fav_topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "mappedBy": "fav_users"
    },
    "onBoarded": {
      "type": "boolean",
      "default": false
    },
    "grade": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::class.class",
      "inversedBy": "user"
    },
    "teaching": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "tutors"
    },
    "studying": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "students"
    },
    "title": {
      "type": "enumeration",
      "enum": [
        "IB Facilitator",
        "IB Examiner"
      ]
    },
    "ib_program": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::ib-program.ib-program",
      "inversedBy": "user"
    },
    "grade_score": {
      "type": "integer"
    },
    "dream_profession": {
      "type": "string"
    },
    "dream_profession_secondary": {
      "type": "string"
    },
    "dream_university": {
      "type": "string"
    },
    "fav_subject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subject.subject",
      "inversedBy": "users_fav_subject"
    },
    "college_name": {
      "type": "string"
    },
    "tutor_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tutor-plan.tutor-plan",
      "inversedBy": "users"
    },
    "nationality": {
      "type": "string"
    },
    "lastUploaded": {
      "type": "date"
    },
    "experience": {
      "type": "integer"
    },
    "cv": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "audios",
        "files"
      ]
    },
    "biography": {
      "type": "text"
    },
    "student_plan": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-plan.course-plan"
    },
    "tutor_video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "classroom_limit": {
      "type": "integer",
      "default": 5
    },
    "communities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::community.community",
      "mappedBy": "members"
    },
    "subject_guidance": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subject.subject"
    }
  }
}
