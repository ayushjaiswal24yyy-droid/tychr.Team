{
  "kind": "collectionType",
  "collectionName": "class_requests",
  "info": {
    "singularName": "class-request",
    "pluralName": "class-requests",
    "displayName": "class_requests",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "request_type": {
      "type": "enumeration",
      "enum": [
        "reschedule",
        "cancellation",
        "extra_class"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "reason": {
      "type": "text"
    },
    "new_schedule": {
      "type": "datetime"
    },
    "live_lecture": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::live-lecture.live-lecture",
      "inversedBy": "class_requests"
    },
    "tutor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "class_requests"
    },
    "classroom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::enrollment.enrollment",
      "inversedBy": "class_schedule_requests"
    },
    "processed_at": {
      "type": "datetime"
    },
    "tutor_note": {
      "type": "text"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false
    },
    "requested_by": {
      "displayName": "requested_by",
      "type": "component",
      "repeatable": false,
      "component": "requested-by.requested-by"
    },
    "lectures_unit": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::topic.topic"
    }
  }
}
