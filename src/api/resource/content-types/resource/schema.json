{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "resources",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "article",
        "guide"
      ]
    },
    "context": {
      "type": "enumeration",
      "enum": [
        "essay",
        "interview",
        "financial_aid"
      ]
    },
    "files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "link": {
      "type": "text"
    },
    "detail": {
      "type": "text"
    },
    "mentor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "country": {
      "type": "string"
    }
  }
}
