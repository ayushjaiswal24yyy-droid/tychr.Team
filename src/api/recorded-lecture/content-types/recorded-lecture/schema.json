{
  "kind": "collectionType",
  "collectionName": "recorded_lectures",
  "info": {
    "singularName": "recorded-lecture",
    "pluralName": "recorded-lectures",
    "displayName": "Recorded_Lecture",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "decimal"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "recorded_lecture"
    },
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::topic.topic",
      "inversedBy": "recorded_lectures"
    },
    "order": {
      "type": "integer"
    },
    "qna": {
      "type": "component",
      "repeatable": true,
      "component": "subtopic.qn-a"
    },
    "content": {
      "type": "blocks"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "classrooms": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "recorded_lectures"
    },
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "recorded_lectures"
    },
    "liked_by": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "recorded_lectures"
    },
    "progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::progress.progress",
      "mappedBy": "recorded_lecture"
    },
    "isPremium": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::note.note",
      "inversedBy": "recorded_lectures"
    },
    "tutor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "subtopic": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subtopic.subtopic"
    },
    "program": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::ib-program.ib-program"
    }
  }
}
