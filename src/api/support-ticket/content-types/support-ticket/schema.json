{
  "kind": "collectionType",
  "collectionName": "support_tickets",
  "info": {
    "singularName": "support-ticket",
    "pluralName": "support-tickets",
    "displayName": "Support Ticket",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "type": {
      "type": "enumeration",
      "enum": ["technical", "non-technical"],
      "required": true
    },
    "admin_message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "New",
        "Open",
        "In Progress",
        "Waiting on Customer",
        "Resolved",
        "Closed"
      ],
      "required": true,
      "default": "New"
    },
    "admin_media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "support_tickets"
    }
  }
}
