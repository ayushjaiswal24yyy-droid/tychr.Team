{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Enquiries",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "notifications"
    },
    "classrooms": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "notifications"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Converted",
        "Rejected"
      ],
      "default": "Pending"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "Failed",
        "Success",
        "Pending"
      ]
    },
    "parent_name": {
      "type": "string"
    },
    "parent_phonenumber": {
      "type": "string"
    },
    "preferred_classroom_time": {
      "type": "enumeration",
      "enum": [
        "Morning",
        "Afternoon",
        "Evening"
      ]
    },
    "comment": {
      "type": "text"
    },
    "conversion_history": {
      "displayName": "history",
      "type": "component",
      "repeatable": true,
      "component": "notification.history"
    },
    "tracking_status": {
      "type": "enumeration",
      "enum": [
        "New Lead",
        "Contacted",
        "Demo Booking",
        "Demo Done",
        "Demo Unattended",
        "Decision Pending 1",
        "Decision Pending 2",
        "Success",
        "Failed"
      ],
      "default": "New Lead"
    },
    "demo_feedback": {
      "type": "text"
    },
    "student_plan": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-plan.course-plan"
    },
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "enquiries"
    },
    "enquiry_type": {
      "type": "enumeration",
      "enum": [
        "Classroom",
        "Student Plan"
      ]
    },
    "classroom_limit": {
      "type": "enumeration",
      "enum": [
        "offline",
        "online"
      ]
    },
    "classroom_type": {
      "type": "enumeration",
      "enum": [
        "offline",
        "online"
      ]
    },
    "parent_location": {
      "type": "string"
    }
  }
}
