{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Enquiries",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "notifications"
    },
    "classroom": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::enrollment.enrollment",
      "inversedBy": "notification"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Converted",
        "Rejected"
      ],
      "default": "Pending"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "Failed",
        "Success",
        "Pending"
      ]
    },
    "parent_name": {
      "type": "string"
    },
    "parent_phonenumber": {
      "type": "string"
    },
    "preferred_classroom_time": {
      "type": "enumeration",
      "enum": [
        "Morning",
        "Afternoon",
        "Evening"
      ]
    },
    "comment": {
      "type": "text"
    }
  }
}
