{
  "kind": "collectionType",
  "collectionName": "student_uni_applications",
  "info": {
    "singularName": "student-uni-application",
    "pluralName": "student-uni-applications",
    "displayName": "studentUniApplication",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "student_uni_applications"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "dream",
        "target",
        "safety",
        "reach",
        "others"
      ]
    },
    "progress": {
      "type": "integer"
    },
    "universityDecision": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Accepted",
        "Rejected",
        "Waitlisted",
        "Deferred",
        "Finalized",
        "Needs Follow Up",
        "Accepted By Student",
        "Rejected by student"
      ]
    },
    "Deadline": {
      "type": "date"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "Submitted",
        "In Progress",
        "Rejected"
      ]
    },
    "university": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::university.university",
      "inversedBy": "student_uni_applications"
    },
    "college": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::college.college",
      "inversedBy": "student_uni_applications"
    },
    "applicationcycle": {
      "type": "component",
      "repeatable": true,
      "component": "university.application-cycle-deadline"
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::program.program",
      "inversedBy": "student_uni_applications"
    },
    "personalstatementessay": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "whyusessay": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "activityessay": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "lor": {
      "type": "component",
      "repeatable": true,
      "component": "lor.lor"
    },
    "essay_submissions": {
      "type": "component",
      "repeatable": true,
      "component": "essays.essay-submission"
    },
    "lor_requests": {
      "displayName": "lor_requests",
      "type": "component",
      "repeatable": true,
      "component": "lor-requests.lor-requests"
    },
    "resume": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "statement_of_purpose": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tasks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::task.task",
      "mappedBy": "student_uni_application"
    },
    "application_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "payment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payment.payment",
      "inversedBy": "student_uni_application"
    }
  }
}
