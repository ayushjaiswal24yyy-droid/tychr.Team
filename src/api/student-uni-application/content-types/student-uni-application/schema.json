{
  "kind": "collectionType",
  "collectionName": "student_uni_applications",
  "info": {
    "singularName": "student-uni-application",
    "pluralName": "student-uni-applications",
    "displayName": "studentUniApplication",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "student_uni_applications"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "dream",
        "target",
        "safety",
        "reach",
        "others"
      ]
    },
    "progress": {
      "type": "integer"
    },
    "universityDecision": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Accepted",
        "Rejected",
        "Waitlisted",
        "Deferred"
      ]
    },
    "Deadline": {
      "type": "date"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "Submitted",
        "In Progress",
        "Rejected"
      ]
    },
    "university": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::university.university",
      "inversedBy": "student_uni_applications"
    },
    "college": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::college.college",
      "inversedBy": "student_uni_applications"
    },
    "applicationcycle": {
      "type": "component",
      "repeatable": true,
      "component": "university.application-cycle-deadline"
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::program.program",
      "inversedBy": "student_uni_applications"
    },
    "personalstatementessay": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    },
    "whyusessay": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    },
    "activityessay": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    }
  }
}
