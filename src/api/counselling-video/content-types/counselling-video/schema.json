{
  "kind": "collectionType",
  "collectionName": "counselling_videos",
  "info": {
    "singularName": "counselling-video",
    "pluralName": "counselling-videos",
    "displayName": "counselling-video",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "createdAt": {
      "type": "datetime"
    },
    "updatedAt": {
      "type": "datetime"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "videoUrl": {
      "type": "string",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "duration": {
      "type": "integer"
    },
    "tags": {
      "type": "json"
    },
    "department": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "USA",
        "Canada",
        "UK",
        "Australia",
        "Other"
      ]
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "university": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::university.university",
      "inversedBy": "videos"
    }
  }
}
