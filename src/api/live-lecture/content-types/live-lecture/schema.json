{
  "kind": "collectionType",
  "collectionName": "live_lectures",
  "info": {
    "singularName": "live-lecture",
    "pluralName": "live-lectures",
    "displayName": "Live_Lecture",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "teams_join_url": {
      "type": "string",
      "required": true
    },
    "teams_meeting_id": {
      "type": "string",
      "required": true,
      "description": "Microsoft Graph onlineMeeting.id"
    },
    "recording_url": {
      "type": "string",
      "description": "SharePoint or OneDrive playback URL"
    },
    "recording_file_id": {
      "type": "string",
      "description": "Drive item id from Microsoft Graph"
    },
    "recorded_at": {
      "type": "datetime"
    },
    "recording_duration_seconds": {
      "type": "integer"
    },
    "has_recording": {
      "type": "boolean",
      "default": false
    },
    "schedule": {
      "type": "datetime",
      "required": true
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "decimal"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "live_lecture"
    },
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::topic.topic",
      "inversedBy": "live_lectures"
    },
    "classroom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::enrollment.enrollment",
      "inversedBy": "live_lectures"
    },
    "class_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::class-request.class-request",
      "mappedBy": "live_lecture"
    },
    "is_cancelled": {
      "type": "boolean",
      "default": false
    },
    "recording_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "available",
        "failed"
      ],
      "default": "pending"
    },
    "cancellation_reason": {
      "type": "text"
    },
    "is_resheduled": {
      "type": "boolean"
    },
    "reschedule_count": {
      "type": "integer",
      "default": 0
    },
    "allow_reschedule": {
      "type": "boolean",
      "default": true
    },
    "reschedule_deadline_hours": {
      "type": "integer",
      "default": 24
    },
    "lecture_status": {
      "type": "enumeration",
      "enum": [
        "scheduled",
        "rescheduled",
        "cancelled",
        "completed"
      ],
      "default": "scheduled"
    },
    "status_history": {
      "type": "json"
    },
    "attendance": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::attendance.attendance",
      "mappedBy": "live_lecture"
    },
    "reminderSent": {
      "type": "boolean",
      "default": false
    },
    "lecture_feedbacks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lecture-feedback.lecture-feedback",
      "mappedBy": "live_lecture"
    },
    "tutor_duration_minutes": {
      "type": "integer",
      "description": "Actual minutes the tutor was present in the meeting"
    },
    "is_counted": {
      "type": "boolean",
      "default": false,
      "description": "Whether this lecture meets the 80% attendance threshold"
    },
    "tutor_attendance_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "passed",
        "failed"
      ],
      "default": "pending"
    },
    "tutor_attendance_flagged_at": {
      "type": "datetime",
      "description": "When the system flagged this lecture as not counted"
    },
    "tutor_dispute": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::tutor-dispute.tutor-dispute",
      "inversedBy": "live_lecture"
    }
  }
}
