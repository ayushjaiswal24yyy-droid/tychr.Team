{
  "kind": "collectionType",
  "collectionName": "live_lectures",
  "info": {
    "singularName": "live-lecture",
    "pluralName": "live-lectures",
    "displayName": "Live_Lecture",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "zoom_url": {
      "type": "string"
    },
    "schedule": {
      "type": "datetime"
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "decimal"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "live_lecture"
    },
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::topic.topic",
      "inversedBy": "live_lectures"
    },
    "classrooms": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::enrollment.enrollment",
      "inversedBy": "live_lectures"
    },
    "class_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::class-request.class-request",
      "mappedBy": "live_lecture"
    },
    "is_cancelled": {
      "type": "boolean",
      "default": false
    },
    "cancellation_reason": {
      "type": "text"
    },
    "allow_reschedule": {
      "type": "boolean",
      "default": true
    },
    "reschedule_deadline_hours": {
      "type": "integer",
      "default": 24
    }
  }
}
