{
  "kind": "collectionType",
  "collectionName": "grade_subjects",
  "info": {
    "singularName": "grade-subject",
    "pluralName": "grade-subjects",
    "displayName": "Grade Subject",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "isRequired": {
      "type": "boolean",
      "default": true
    },
    "topics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::topic.topic",
      "mappedBy": "grade_subject"
    },
    "reference_books": {
      "type": "component",
      "repeatable": true,
      "component": "subject.refrence-books"
    },
    "subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subject.subject",
      "inversedBy": "grade_subjects"
    },
    "grade": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::class.class",
      "inversedBy": "grade_subjects"
    },
    "name": {
      "type": "string"
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "SL",
        "HL",
        "None"
      ]
    },
    "demo_video": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "inversedBy": "grade_subjects"
    },
    "classrooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "grade_subject"
    },
    "subject_group": {
      "type": "string"
    },
    "test_series": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::test-serie.test-serie",
      "mappedBy": "grade_subject"
    }
  }
}
