{
  "kind": "collectionType",
  "collectionName": "grade_subjects",
  "info": {
    "singularName": "grade-subject",
    "pluralName": "grade-subjects",
    "displayName": "⭐Lecture: Grade Subject",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "isRequired": {
      "type": "boolean",
      "default": true
    },
    "topics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::topic.topic",
      "mappedBy": "grade_subject"
    },
    "reference_books": {
      "type": "component",
      "repeatable": true,
      "component": "subject.refrence-books"
    },
    "subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subject.subject",
      "inversedBy": "grade_subjects"
    },
    "test_series_price": {
      "type": "decimal"
    },
    "grade": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::class.class",
      "inversedBy": "grade_subjects"
    },
    "name": {
      "type": "string"
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "SL",
        "HL",
        "None"
      ]
    },
    "classrooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "grade_subject"
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "mappedBy": "grade_subject"
    },
    "is_live": {
      "type": "boolean",
      "default": false
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "grade_subject"
    },
    "enquiries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "grade_subject"
    },
    "subject_group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subject-group.subject-group",
      "inversedBy": "grade_subjects"
    },
    "user_demo_classes_grade_plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-grade-plan.user-grade-plan",
      "mappedBy": "grade_subject"
    },
    "test_series": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::test-serie.test-serie",
      "mappedBy": "grade_subject"
    },
    "image": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    }
  }
}
