{
  "kind": "collectionType",
  "collectionName": "question_banks",
  "info": {
    "singularName": "question-bank",
    "pluralName": "question-banks",
    "displayName": "Question Bank",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "parts": {
      "type": "component",
      "repeatable": true,
      "component": "question-bank.parts"
    },
    "question": {
      "type": "richtext"
    },
    "note": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::note.note",
      "inversedBy": "question_banks"
    },
    "question_type": {
      "type": "enumeration",
      "enum": [
        "mcq",
        "single_part",
        "multiple_part"
      ]
    },
    "unit": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::topic.topic"
    },
    "attachment": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "test_series": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::test-serie.test-serie",
      "mappedBy": "question_banks"
    },
    "marks": {
      "type": "integer"
    }
  }
}
