{
  "kind": "collectionType",
  "collectionName": "question_banks",
  "info": {
    "singularName": "question-bank",
    "pluralName": "question-banks",
    "displayName": "Question Bank",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "richtext",
      "required": true
    },
    "content_format": {
      "type": "enumeration",
      "enum": [
        "html",
        "markdown",
        "richtext"
      ],
      "default": "richtext"
    },
    "question_type": {
      "type": "enumeration",
      "enum": [
        "mcq",
        "mcq_multiple",
        "short_answer",
        "long_answer",
        "match_columns",
        "drag_drop",
        "ranking",
        "data_interpretation",
        "multimedia"
      ],
      "required": true
    },
    "marks": {
      "type": "integer",
      "required": true
    },
    "is_offline": {
      "type": "boolean",
      "default": false
    },
    "parts": {
      "type": "component",
      "repeatable": true,
      "component": "question-bank.parts"
    },
    "test_series": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::test-serie.test-serie",
      "mappedBy": "question_banks"
    },
    "unit": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::topic.topic"
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "note": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::note.note",
      "inversedBy": "question_banks"
    }
  }
}
