{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment",
    "description": "Payment records for subscriptions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "subscription": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subscription.subscription",
      "inversedBy": "payments"
    },
    "payment_type": {
      "type": "enumeration",
      "enum": [
        "classroom_only",
        "classroom_with_live",
        "live_lectures_only",
        "test_series_only",
        "live_lectures_addon"
      ],
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "razorpay_payment_id": {
      "type": "string"
    },
    "razorpay_order_id": {
      "type": "string",
      "unique": true
    },
    "razorpay_signature": {
      "type": "string"
    },
    "items": {
      "type": "json",
      "required": true,
      "default": {
        "classroom": false,
        "live_lectures_count": 0,
        "test_series": false
      }
    },
    "price_details": {
      "type": "json",
      "default": {
        "classroom_price": 0,
        "live_lecture_price": 0,
        "test_series_price": 0,
        "commission": 0,
        "gst": 0,
        "total": 0
      }
    },
    "metadata": {
      "type": "json"
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "payments"
    }
  }
}
