{
  "kind": "collectionType",
  "collectionName": "test_series",
  "info": {
    "singularName": "test-serie",
    "pluralName": "test-series",
    "displayName": "Test Series",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "program_type": {
      "type": "enumeration",
      "enum": [
        "IB_PYP",
        "IB_MYP",
        "IB_DP",
        "AP",
        "SAT",
        "ACT",
        "AS_A_LEVELS",
        "IGCSE"
      ]
    },
    "test_mode": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline",
        "hybrid"
      ],
      "default": "online",
      "required": true
    },
    "test_type": {
      "type": "enumeration",
      "enum": [
        "Practice Test",
        "Test Series"
      ]
    },
    "ai_evaluation_enabled": {
      "type": "boolean",
      "default": true
    },
    "year": {
      "type": "integer"
    },
    "test_duration": {
      "type": "decimal"
    },
    "instructions": {
      "type": "richtext"
    },
    "allowed_question_types": {
      "type": "json"
    },
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "test_series"
    },
    "pass_mark": {
      "type": "decimal"
    },
    "question_banks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::question-bank.question-bank",
      "inversedBy": "test_series"
    },
    "test_papers": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "is_global": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string"
    },
    "answers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer.answer",
      "mappedBy": "test_series"
    },
    "formula_booklet": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "instruction_booklet": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "resource_name": {
      "type": "string"
    },
    "resource_description": {
      "type": "text"
    },
    "resource": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "start_date": {
      "type": "datetime"
    },
    "parent_test_series": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::test-serie.test-serie",
      "inversedBy": "papers"
    },
    "papers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::test-serie.test-serie",
      "mappedBy": "parent_test_series"
    },
    "entity_type": {
      "type": "enumeration",
      "enum": [
        "series",
        "paper"
      ]
    },
    "offline_pdf": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "reading_time": {
      "type": "integer"
    },
    "solution_pdf": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    }
  }
}