{
  "kind": "collectionType",
  "collectionName": "test_series",
  "info": {
    "singularName": "test-serie",
    "pluralName": "test-series",
    "displayName": "Test Series",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "test_series"
    },
    "title": {
      "type": "string"
    },
    "test_duration": {
      "type": "integer"
    },
    "pass_mark": {
      "type": "integer"
    },
    "question_banks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::question-bank.question-bank",
      "inversedBy": "test_series"
    },
    "test_mode": {
      "type": "enumeration",
      "enum": ["online", "offline", "hybrid"],
      "default": "online"
    },
    "test_type": {
      "type": "enumeration",
      "enum": ["Practice Test", "Test Series"]
    },
    "allowed_question_types": {
      "type": "json"
    },
    "instructions": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "year": {
      "type": "integer"
    },
    "answers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer.answer",
      "mappedBy": "test_series"
    },
    "resource_booklet": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "instruction_booklet": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
        "test_papers": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["files", "images"]
    },
    "is_global": {
      "type": "boolean",
      "default": false
    }
  }
}
