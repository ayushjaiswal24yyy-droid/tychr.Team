{
  "kind": "collectionType",
  "collectionName": "third_party_orgs",
  "info": {
    "singularName": "third-party-org",
    "pluralName": "third-party-orgs",
    "displayName": "Third Party Org"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "years_running": {
      "type": "integer"
    },
    "location": {
      "type": "string"
    },
    "offerings": {
  "type": "relation",
  "relation": "oneToMany",
  "target": "api::third-party-offering.third-party-offering",
  "mappedBy": "org"
},
    "website": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "cause": {
      "type": "string"
    },
    "company_type": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "verification_upload": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "linkedin_url": {
      "type": "string"
    },
    "twitter": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "tiktok": {
      "type": "string"
    },
    "org_type": {
      "type": "enumeration",
      "enum": [
        "student_org",
        "ngo",
        "corporate_firm"
      ]
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "third_party_org"
    }
  }
}