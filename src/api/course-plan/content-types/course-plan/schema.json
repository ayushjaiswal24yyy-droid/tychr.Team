{
  "kind": "collectionType",
  "collectionName": "course_plans",
  "info": {
    "singularName": "course-plan",
    "pluralName": "course-plans",
    "displayName": "Course Plan",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "live_lectures": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "recorded_lectures": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "decimal"
    },
    "qna": {
      "type": "boolean",
      "default": true
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "INR"
      ]
    },
    "grade_subjects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "course_plans"
    },
    "description": {
      "type": "text"
    },
    "ib_programs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ib-program.ib-program",
      "inversedBy": "course_plans"
    },
    "grades": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::class.class",
      "inversedBy": "course_plans"
    },
    "classrooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "course_plan"
    },
    "enrolled_by": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "enrolled_in"
    }
  }
}
