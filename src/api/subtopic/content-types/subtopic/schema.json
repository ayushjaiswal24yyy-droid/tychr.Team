{
  "kind": "collectionType",
  "collectionName": "subtopics",
  "info": {
    "singularName": "subtopic",
    "pluralName": "subtopics",
    "displayName": "⭐Lectures: sub-topics",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::topic.topic",
      "inversedBy": "subtopics"
    },
    "headings": {
      "type": "component",
      "repeatable": true,
      "component": "subtopic.heading"
    },
    "notes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::note.note",
      "mappedBy": "topics"
    },
    "classrooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::enrollment.enrollment",
      "mappedBy": "topic"
    }
  }
}
