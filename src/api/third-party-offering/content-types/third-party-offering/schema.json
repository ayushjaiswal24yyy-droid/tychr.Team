{
  "kind": "collectionType",
  "collectionName": "third_party_offerings",
  "info": {
    "singularName": "third-party-offering",
    "pluralName": "third-party-offerings",
    "displayName": "⭐Third Party Offering",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "eligibility": {
      "type": "text"
    },
    "degree": {
      "type": "text"
    },
    "field_of_study": {
      "type": "text"
    },
    "year": {
      "type": "text"
    },
    "skills_required": {
      "type": "json"
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "weekly_time_commitment": {
      "type": "decimal"
    },
    "total_duration": {
      "type": "decimal"
    },
    "compensation": {
      "type": "text"
    },
    "is_paid": {
      "type": "boolean",
      "default": false
    },
    "stipend": {
      "type": "text"
    },
    "currency": {
      "type": "text"
    },
    "Location": {
      "type": "string"
    },
    "selection_process": {
      "type": "text"
    },
    "benefits": {
      "type": "json"
    },
    "application_process": {
      "type": "json"
    },
    "created_by_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "third_party_offerings"
    },
    "tp_applicants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tp-applicant.tp-applicant",
      "mappedBy": "third_party_offering"
    },
    "college_tag": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::college.college",
      "inversedBy": "third_party_offerings"
    },
    "activity_type": {
      "type": "enumeration",
      "enum": [
        "internship",
        "research",
        "bootcamp",
        "competition",
        "volunteer",
        "workshop",
        "fellowship",
        "other"
      ],
      "required": true,
      "default": "other"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "stem",
        "arts",
        "business",
        "social-science",
        "medicine",
        "law",
        "engineering",
        "education",
        "environment",
        "other"
      ],
      "required": true,
      "default": "other"
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "Delhi", "Mumbai", "Bangalore", "Hyderabad", "Chennai", "Kolkata", "Pune", "Ahmedabad", "Jaipur", "Surat", "Lucknow", "Kanpur", "Nagpur", "Indore", "Bhopal", "Patna", "Ranchi", "Chandigarh", "Kochi", "Thiruvananthapuram", "Coimbatore", "Visakhapatnam", "Vijayawada", "Mysore", "Nashik", "Vadodara", "Rajkot", "Agra", "Varanasi", "Amritsar", "Ludhiana", "Jodhpur", "Udaipur", "Dehradun", "Noida", "Gurgaon", "Faridabad", "Ghaziabad", "Meerut", "Raipur", "Bhubaneswar", "Guwahati", "Shillong", "Imphal", "Aizawl", "Itanagar", "Gangtok", "Panaji", "Shimla", "Jammu"
      ],
      "required": true
    },
    "is_remote": {
      "type": "boolean",
      "default": false
    },
    "tasks": {
      "type": "component",
      "repeatable": true,
      "component": "offering.task"
    },
    "target_professions": {
      "type": "json"
    },
    "skill_tags": {
      "type": "json"
    }
  }
}
