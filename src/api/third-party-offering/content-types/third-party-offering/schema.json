{
  "kind": "collectionType",
  "collectionName": "third_party_offerings",
  "info": {
    "singularName": "third-party-offering",
    "pluralName": "third-party-offerings",
    "displayName": "⭐Third Party Offering",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "eligibility": {
      "type": "text"
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "weekly_time_commitment": {
      "type": "decimal"
    },
    "total_duration": {
      "type": "decimal"
    },
    "compensation": {
      "type": "text"
    },
    "Location": {
      "type": "string"
    },
    "selection_process": {
      "type": "text"
    },
    "benefits": {
      "type": "json"
    },
    "application_process": {
      "type": "json"
    },
    "created_by_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "third_party_offerings"
    },
    "tp_applicants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tp-applicant.tp-applicant",
      "mappedBy": "third_party_offering"
    },
    "college_tag": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::college.college",
      "inversedBy": "third_party_offerings"
    },
    "activity_type": {
      "type": "enumeration",
      "enum": [
        "internship",
        "research",
        "bootcamp",
        "competition",
        "volunteer",
        "workshop",
        "fellowship",
        "other"
      ],
      "required": true,
      "default": "other"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "stem",
        "arts",
        "business",
        "social-science",
        "medicine",
        "law",
        "engineering",
        "education",
        "environment",
        "other"
      ],
      "required": true,
      "default": "other"
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "north-america",
        "south-america",
        "europe",
        "south-asia",
        "east-asia",
        "southeast-asia",
        "middle-east",
        "africa",
        "oceania",
        "global-remote"
      ],
      "required": true,
      "default": "global-remote"
    },
    "is_remote": {
      "type": "boolean",
      "default": false
    },
    "tasks": {
      "type": "component",
      "repeatable": true,
      "component": "offering.task"
    },
    "target_professions": {
      "type": "json"
    },
    "skill_tags": {
      "type": "json"
    }
  }
}