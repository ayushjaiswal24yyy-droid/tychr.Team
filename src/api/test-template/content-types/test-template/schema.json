{
  "kind": "collectionType",
  "collectionName": "test_templates",
  "info": {
    "singularName": "test-template",
    "pluralName": "test-templates",
    "displayName": "Test Template"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "ib_program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ib-program.ib-program"
    },
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject"
    },
    "description": {
      "type": "text"
    },
    "is_generic": true,
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "test-template.section"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}