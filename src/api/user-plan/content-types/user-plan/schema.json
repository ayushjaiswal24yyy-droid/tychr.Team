{
  "kind": "collectionType",
  "collectionName": "user_plans",
  "info": {
    "singularName": "user-plan",
    "pluralName": "user-plans",
    "displayName": "UserPlan",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
