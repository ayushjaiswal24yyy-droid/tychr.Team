      "target": "api::premium-plan.premium-plan",
      "inversedBy": "user_plans"
    },
    "remaining_hours": {
      "type": "decimal"
    },
    "expires_at": {
      "type": "datetime"
    },
    "purchased_at": {
      "type": "datetime",
      "required": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "expired",
        "used_up"
      ],
      "default": "active"
    },
    "razorpay_payment_id": {
      "type": "string"
    },
    "razorpay_order_id": {
      "type": "string"
    },
    "razorpay_signature": {
      "type": "string"
    }
  }
}
