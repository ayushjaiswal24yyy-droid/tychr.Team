{
  "kind": "collectionType",
  "collectionName": "user_plans",
  "info": {
    "singularName": "user-plan",
    "pluralName": "user-plans",
    "displayName": "⭐Student: UserPlan"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_plans"
    },
    "premium_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::premium-plan.premium-plan",
      "inversedBy": "user_plans"
    },
    "remaining_hours": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "used_up"],
      "default": "active"
    },
    "purchased_at": {
      "type": "datetime",
      "required": true
    },
    "price_at_purchase": {
      "type": "decimal",
      "required": true
    },
    "total_paid": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "enumeration",
      "enum": ["INR", "USD"],
      "required": true
    },
    "razorpay_payment_id": {
      "type": "string"
    },
    "razorpay_order_id": {
      "type": "string"
    },
    "student_meetings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::student-meeting.student-meeting",
      "mappedBy": "user_plan"
    },
    "admin_transaction_outs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction-out.transaction-out",
      "mappedBy": "user_plan"
    }
  }
}