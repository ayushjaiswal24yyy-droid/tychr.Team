{
  "kind": "collectionType",
  "collectionName": "answers",
  "info": {
    "singularName": "answer",
    "pluralName": "answers",
    "displayName": "Answer",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "answers"
    },
    "submission_type": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline",
        "hybrid"
      ],
      "default": "online"
    },
    "marks": {
      "type": "decimal"
    },
    "question_n_answer": {
      "type": "component",
      "repeatable": true,
      "component": "question-bank.question-n-answer"
    },
    "uploaded_answer_sheet": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "submission_date": {
      "type": "datetime"
    },
    "time_taken": {
      "type": "integer"
    },
    "evaluation_status": {
      "type": "enumeration",
      "enum": [
        "evaluated",
        "pending",
        "in_progress"
      ],
      "default": "pending"
    },
    "student_feedback": {
      "type": "text"
    },
    "tutor_feedback": {
      "type": "text"
    },
    "tutor_classroom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::enrollment.enrollment",
      "inversedBy": "answers"
    },
    "test_series": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::test-serie.test-serie",
      "inversedBy": "answers"
    },
    "online_answers": {
      "type": "json"
    },
    "completed": {
      "type": "boolean",
      "required": true
    },
    "is_attempt_marker": {
      "type": "boolean",
      "default": false
    },
    "attempt_id": {
      "type": "integer"
    },
    "phase": {
      "type": "enumeration",
      "enum": [
        "reading",
        "answering",
        "completed"
      ]
    },
    "phase_started_at": {
      "type": "datetime"
    },
    "started_at": {
      "type": "datetime"
    },
    "violation_count": {
      "type": "integer",
      "default": 0
    },
    "auto_submitted": {
      "type": "boolean",
      "default": false
    },
    "resume_requested": {
      "type": "boolean",
      "default": false
    },
    "resume_status": {
      "type": "enumeration",
      "enum": [
        "none",
        "requested",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "resume_requested_at": {
      "type": "datetime"
    },
    "resume_approved_at": {
      "type": "datetime"
    },
    "resume_reason": {
      "type": "text"
    }
  }
}
