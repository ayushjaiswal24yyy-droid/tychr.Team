{
  "kind": "collectionType",
  "collectionName": "answers",
  "info": {
    "singularName": "answer",
    "pluralName": "answers",
    "displayName": "Answer",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "answers"
    },
    "submission_type": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline_upload"
      ],
      "default": "online"
    },
    "marks": {
      "type": "decimal"
    },
    "question_n_answer": {
      "type": "component",
      "repeatable": true,
      "component": "question-bank.question-n-answer"
    },
    "uploaded_answer_sheet": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "submission_date": {
      "type": "datetime"
    },
    "time_taken": {
      "type": "integer"
    },
    "evaluation_status": {
      "type": "enumeration",
      "enum": [
        "evaluated",
        "pending"
      ],
      "default": "pending"
    },
    "student_feedback": {
      "type": "text"
    },
    "tutor_feedback": {
      "type": "text"
    },
    "tutor_classroom": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::enrollment.enrollment",
      "inversedBy": "answer"
    },
    "test_sery": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::test-serie.test-serie",
      "inversedBy": "answers"
    },
    "online_answers": {
      "type": "json"
    }
  }
}
