{
  "kind": "collectionType",
  "collectionName": "answers",
  "info": {
    "singularName": "answer",
    "pluralName": "answers",
    "displayName": "Answer",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "answers"
    },
    "test_series": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::test-serie.test-serie",
      "inversedBy": "answers"
    },
    "marks": {
      "type": "decimal"
    },
    "question_n_answer": {
      "type": "component",
      "repeatable": true,
      "component": "question-bank.question-n-answer"
    },
    "evaluation_status": {
      "type": "enumeration",
      "enum": [
        "Completed",
        "Need to Evaluate"
      ],
      "default": "Need to Evaluate"
    },
    "student_feedback": {
      "type": "text"
    },
    "tutor_feedback": {
      "type": "text"
    },
    "tutor_classroom": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::enrollment.enrollment",
      "inversedBy": "answer"
    }
  }
}
