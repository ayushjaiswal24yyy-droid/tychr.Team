{
  "kind": "collectionType",
  "collectionName": "notes",
  "info": {
    "singularName": "note",
    "pluralName": "notes",
    "displayName": "Notes",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "prompt_status": {
      "type": "enumeration",
      "enum": [
        "pending ",
        "under_progress",
        "generated"
      ]
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subtopic.subtopic",
      "inversedBy": "notes"
    },
    "question_banks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question-bank.question-bank",
      "mappedBy": "note"
    },
    "note": {
      "type": "richtext"
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "mappedBy": "note"
    },
    "attachment": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "note_type": {
      "type": "enumeration",
      "enum": [
        "strapi",
        "wordpress"
      ]
    },
    "wordpress_url": {
      "type": "string"
    }
  }
}
