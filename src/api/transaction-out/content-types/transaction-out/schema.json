{
  "kind": "collectionType",
  "collectionName": "transaction_outs",
  "info": {
    "singularName": "transaction-out",
    "pluralName": "transaction-outs",
    "displayName": "Admin: Transaction Out"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "student_meeting": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::student-meeting.student-meeting",
      "inversedBy": "admin_transaction_out"
    },
    "meeting_scheduled_with": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "admin_transaction_outs"
    },
    "user_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-plan.user-plan",
      "inversedBy": "admin_transaction_outs"
    },
    "transaction_date": {
      "type": "datetime",
      "required": true
    },
    "duration_minutes": {
      "type": "integer",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "INR",
        "USD"
      ],
      "required": true
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    }
  }
}
