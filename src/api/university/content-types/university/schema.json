{
  "kind": "collectionType",
  "collectionName": "universities",
  "info": {
    "singularName": "university",
    "pluralName": "universities",
    "displayName": "Admin: university",
    "description": "Admin will add universities"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "university_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "university_type": {
      "type": "string"
    },
    "year_of_establishment": {
      "type": "integer"
    },
    "world_rank": {
      "type": "integer"
    },
    "acceptance_rate": {
      "type": "decimal"
    },
    "stats": {
      "type": "component",
      "repeatable": false,
      "component": "university.key-stats"
    },
    "global_ranking": {
      "type": "component",
      "repeatable": false,
      "component": "university.global-ranking"
    },
    "subject_ranking": {
      "type": "component",
      "repeatable": false,
      "component": "university.subject-ranking"
    },
    "overview": {
      "type": "component",
      "repeatable": false,
      "component": "university.overview"
    },
    "financial_aids": {
      "type": "component",
      "repeatable": false,
      "component": "university.financial-aids"
    },
    "additional_costs": {
      "type": "component",
      "repeatable": false,
      "component": "university.additional-costs"
    },
    "university_articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "university"
    },
    "student_uni_applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::student-uni-application.student-uni-application",
      "mappedBy": "university"
    },
    "colleges": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::college.college"
    },
    "videos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::counselling-video.counselling-video",
      "mappedBy": "university"
    },
    "verified": {
      "type": "boolean"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "fav_universities"
    }
  }
}
