    },
    "founder_details": {
      "displayName": "founder",
      "type": "component",
      "repeatable": false,
      "component": "external-users.founder"
    },
    "position_details": {
      "displayName": "position",
      "type": "component",
      "repeatable": false,
      "component": "external-users.position"
    }
