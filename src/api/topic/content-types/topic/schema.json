{
  "kind": "collectionType",
  "collectionName": "topics",
  "info": {
    "singularName": "topic",
    "pluralName": "topics",
    "displayName": "Lectures: Units",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "subtopics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subtopic.subtopic",
      "mappedBy": "topic"
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "mappedBy": "topic"
    },
    "live_lectures": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::live-lecture.live-lecture",
      "mappedBy": "topic"
    },
    "fav_users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "fav_topics"
    },
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "topics"
    },
    "isPaid": {
      "type": "boolean",
      "default": true
    },
    "doubt_sections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::doubt-section.doubt-section",
      "mappedBy": "topic"
    }
  }
}
