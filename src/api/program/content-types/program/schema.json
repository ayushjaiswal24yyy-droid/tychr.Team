{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "singularName": "program",
    "pluralName": "programs",
    "displayName": "Program",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "program_name": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "program_overview": {
      "type": "text"
    },
    "career_prospects": {
      "type": "text"
    },
    "application_deadlines": {
      "type": "component",
      "repeatable": true,
      "component": "university.application-cycle-deadline"
    },
    "student_uni_applications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::student-uni-application.student-uni-application",
      "mappedBy": "program"
    },
    "colleges": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::college.college",
      "inversedBy": "programs"
    },
    "program_type": {
      "type": "enumeration",
      "enum": [
        "UG",
        "PG",
        "Phd"
      ]
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "programs"
    },
    "intakes": {
      "type": "component",
      "repeatable": true,
      "component": "cycles.cycle"
    },
    "tution_fees": {
      "type": "component",
      "repeatable": false,
      "component": "university.tution-fees"
    },
    "world_rank": {
      "type": "integer"
    },
    "financial_aids": {
      "type": "component",
      "repeatable": false,
      "component": "university.financial-aids"
    },
    "admission_requirements": {
      "type": "component",
      "repeatable": true,
      "component": "exams.exams"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "fav_programs"
    }
  }
}
