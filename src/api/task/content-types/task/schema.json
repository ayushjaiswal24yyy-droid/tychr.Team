{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "⭐tasks",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "text",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "date": {
      "type": "datetime"
    },
    "planDate": {
      "type": "date"
    },
    "time": {
      "type": "time"
    },
    "description": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "student": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "progress": {
      "type": "integer",
      "max": 100,
      "default": 0
    },
    "priority": {
      "type": "enumeration",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "taskCategory": {
      "type": "enumeration",
      "enum": [
        "essay",
        "academics",
        "interview",
        "financial-ain-consultation",
        "lor",
        "others"
      ],
      "required": true
    },
    "isImportant": {
      "type": "boolean",
      "default": false
    },
    "student_uni_application": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::student-uni-application.student-uni-application",
      "inversedBy": "tasks"
    }
  }
}
