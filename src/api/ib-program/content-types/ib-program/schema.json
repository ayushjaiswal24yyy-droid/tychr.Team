{
  "kind": "collectionType",
  "collectionName": "ib_programs",
  "info": {
    "singularName": "ib-program",
    "pluralName": "ib-programs",
    "displayName": "IB_program",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "grade_range": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "course_plans": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::course-plan.course-plan",
      "mappedBy": "ib_programs"
    },
    "grades": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::class.class",
      "mappedBy": "ib_programs"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "ib_program"
    },
    "is_live": {
      "type": "boolean",
      "default": false
    },
    "subject_groups": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::subject-group.subject-group",
      "mappedBy": "ib_program"
    },
    "add_ons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::add-on.add-on",
      "mappedBy": "ib_program"
    },
    "notifications_enquiries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "ib_program"
    },
    "curriculum": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curriculum.curriculum",
      "inversedBy": "ib_programs"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "programs"
    }
  }
}
