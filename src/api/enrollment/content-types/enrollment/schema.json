{
  "kind": "collectionType",
  "collectionName": "enrollments",
  "info": {
    "singularName": "enrollment",
    "pluralName": "enrollments",
    "displayName": "Classroom",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "enrollment_date": {
      "type": "date"
    },
    "isPaid": {
      "type": "boolean",
      "default": true
    },
    "payment_amount": {
      "type": "decimal"
    },
    "payment_date": {
      "type": "date"
    },
    "tutors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "teaching"
    },
    "students": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "studying"
    },
    "classroom_name": {
      "type": "string"
    },
    "course_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-plan.course-plan",
      "inversedBy": "classrooms"
    },
    "live_lectures": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::live-lecture.live-lecture",
      "mappedBy": "classrooms"
    },
    "tabs": {
      "type": "component",
      "repeatable": true,
      "component": "lectures.lecture-header"
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "inversedBy": "classrooms"
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "inversedBy": "classrooms"
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "days": {
      "type": "json"
    },
    "startTime": {
      "type": "time"
    },
    "duration": {
      "type": "integer"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Approved"
      ]
    },
    "grade_subject": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "classroom"
    },
    "classroom_limit": {
      "type": "integer"
    }
  }
}
