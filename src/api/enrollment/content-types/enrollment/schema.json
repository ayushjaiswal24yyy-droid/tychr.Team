{
  "kind": "collectionType",
  "collectionName": "enrollments",
  "info": {
    "singularName": "enrollment",
    "pluralName": "enrollments",
    "displayName": "Classroom",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "enrollment_date": {
      "type": "date"
    },
    "isPaid": {
      "type": "boolean",
      "default": true
    },
    "payment_amount": {
      "type": "decimal"
    },
    "payment_date": {
      "type": "date"
    },
    "tutors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "teaching"
    },
    "students": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "studying"
    },
    "classroom_name": {
      "type": "string"
    },
    "course_plan": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-plan.course-plan",
      "mappedBy": "classroom"
    }
  }
}
