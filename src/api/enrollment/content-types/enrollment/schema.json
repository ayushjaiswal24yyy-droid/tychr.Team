{
  "kind": "collectionType",
  "collectionName": "enrollments",
  "info": {
    "singularName": "enrollment",
    "pluralName": "enrollments",
    "displayName": "⭐Tutor: Classroom",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "enrollment_date": {
      "type": "date"
    },
    "isPaid": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "decimal"
    },
    "payment_date": {
      "type": "date"
    },
    "tutor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "teachings"
    },
    "students": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "studying"
    },
    "classroom_name": {
      "type": "string"
    },
    "course_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-plan.course-plan",
      "inversedBy": "classrooms"
    },
    "live_lectures": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::live-lecture.live-lecture",
      "mappedBy": "classrooms"
    },
    "tabs": {
      "type": "component",
      "repeatable": true,
      "component": "lectures.lecture-header"
    },
    "recorded_lectures": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recorded-lecture.recorded-lecture",
      "inversedBy": "classrooms"
    },
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subtopic.subtopic",
      "inversedBy": "classrooms"
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "duration": {
      "type": "integer"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Requested",
        "Approved",
        "Responded",
        "Requested Demo"
      ]
    },
    "grade_subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade-subject.grade-subject",
      "inversedBy": "classrooms"
    },
    "classroom_type": {
      "type": "enumeration",
      "enum": [
        "one-on-one",
        "group"
      ]
    },
    "group_limit": {
      "type": "integer",
      "default": 10
    },
    "days": {
      "displayName": "days",
      "type": "component",
      "repeatable": true,
      "component": "classroom.days"
    },
    "isAssist": {
      "type": "boolean",
      "default": false
    },
    "assistants": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "classrooms"
    },
    "notices": {
      "displayName": "notices",
      "type": "component",
      "repeatable": true,
      "component": "classroom.notices"
    },
    "notifications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::notification.notification",
      "inversedBy": "classrooms"
    },
    "community": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::community.community",
      "mappedBy": "classroom"
    },
    "demo_video": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::recorded-lecture.recorded-lecture"
    },
    "ib_program": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::ib-program.ib-program"
    },
    "grade": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::class.class"
    },
    "additional_resources": {
      "type": "component",
      "repeatable": true,
      "component": "classroom.resources"
    },
    "answers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer.answer",
      "mappedBy": "tutor_classroom"
    },
    "student_notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::student-notification.student-notification",
      "mappedBy": "classroom"
    },
    "class_schedule_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::class-request.class-request",
      "mappedBy": "classroom"
    }
  }
}
